; RAY Pokeri WHDLoad installation. Standard Commodore Installer V43 or newer.
; $VER: Install 0.90 (30.09.2026)
(set @app-name "RAY Pokeri")
(if (< @installer-version (* 43 65536))
  (abort "This installation requires Amiga Installer 43 or newer."))
(welcome)
(set #source (pathonly @icon))
(set @execute-dir #source)
; Same prerequisite check as the WHDLoad/Rescue on Fractalus install template.
(if (<> 0 (run "cd SYS:\nWhich WHDLoad >NIL:"))
  (abort "Install WHDLoad 17 or newer first. It must be accessible via the command path. See https://www.whdload.de/"))
(set #kick-ready 0)
(if (and (exists "Devs:Kickstarts/kick40068.A1200") (exists "Devs:Kickstarts/kick40068.A1200.RTB")) (set #kick-ready 1))
(if (and (exists "Devs:Kickstarts/kick40068.A4000") (exists "Devs:Kickstarts/kick40068.A4000.RTB")) (set #kick-ready 1))
(if (and (exists "Devs:Kickstarts/kick40063.A600") (exists "Devs:Kickstarts/kick40063.A600.RTB")) (set #kick-ready 1))
(if (<> (getassign "WHDCOMMON") "")
  ((if (and (exists "WHDCOMMON:kick40068.A1200") (exists "WHDCOMMON:kick40068.A1200.RTB")) (set #kick-ready 1))
   (if (and (exists "WHDCOMMON:kick40068.A4000") (exists "WHDCOMMON:kick40068.A4000.RTB")) (set #kick-ready 1))
   (if (and (exists "WHDCOMMON:kick40063.A600") (exists "WHDCOMMON:kick40063.A600.RTB")) (set #kick-ready 1))))
(if (= #kick-ready 0)
  (message "WHDLoad needs a Kickstart 3.1 image and matching .RTB file in Devs:Kickstarts or WHDCOMMON: before playing. See ReadMe for supported image names." (all)))
(set #parent
  (askdir (prompt "Where should RAY Pokeri be installed? A RAYPokeri drawer will be created here.")
    (help "Choose a writable hard disk drawer with at least 2 MB free.")
    (default @default-dest)))
(set #dest (tackon #parent "RAYPokeri"))
(set #data (tackon #dest "data"))
(if (exists #dest)
  ((set #remove-existing
     (askbool
       (prompt ("The drawer \"%s\" already exists. Remove it, including saved credits and accounting, before installing?" #dest))
       (help "Remove deletes the whole RAYPokeri drawer and its saves. Keep updates the program and preserves ROMs and saves.")
       (choices "Remove" "Keep") (default 0)))
   (if #remove-existing
     (delete #dest (all) (infos) (optional "force") (help @delete-help)))))
(set #have-roms
 (and
  (and (= (exists (tackon #data "77POK30")) 1) (= (exists (tackon #data "77POK38")) 1))
  (and (= (exists (tackon #data "77POK34")) 1) (= (exists (tackon #data "PARA200J")) 1))))
(set #install-roms 1)
(if #have-roms
  (set #install-roms
    (askbool
      (prompt "The four RAY Pokeri ROM files are already installed. Reinstall them or use the existing files?")
      (help "Use existing skips the ROM source drawer question. Reinstall copies the four files from a drawer you select. Saved credits and accounting are kept.")
      (choices "Reinstall" "Use existing") (default 0))))
(if #install-roms
  ((set #roms
    (askdir (prompt "Select the drawer containing your four uncompressed RAY Pokeri ROM files.")
      (help "Required: 77POK30, 77POK38, 77POK34 and PARA200J, each exactly 65536 bytes. ROMs are not included.")
      (default #source)))
   (if (<> (exists (tackon #roms "77POK30")) 1) (abort "Missing ROM: 77POK30"))
   (if (<> (getsize (tackon #roms "77POK30")) 65536) (abort "ROM must be 65536 bytes: 77POK30"))
   (if (<> (exists (tackon #roms "77POK38")) 1) (abort "Missing ROM: 77POK38"))
   (if (<> (getsize (tackon #roms "77POK38")) 65536) (abort "ROM must be 65536 bytes: 77POK38"))
   (if (<> (exists (tackon #roms "77POK34")) 1) (abort "Missing ROM: 77POK34"))
   (if (<> (getsize (tackon #roms "77POK34")) 65536) (abort "ROM must be 65536 bytes: 77POK34"))
   (if (<> (exists (tackon #roms "PARA200J")) 1) (abort "Missing ROM: PARA200J"))
   (if (<> (getsize (tackon #roms "PARA200J")) 65536) (abort "ROM must be 65536 bytes: PARA200J"))
  ))
(makedir #dest (infos) (help @makedir-help))
(makedir #data (help @makedir-help))
(if #install-roms
  (
    (copyfiles (source (tackon #roms "77POK30")) (dest #data) (help @copyfiles-help))
    (copyfiles (source (tackon #roms "77POK38")) (dest #data) (help @copyfiles-help))
    (copyfiles (source (tackon #roms "77POK34")) (dest #data) (help @copyfiles-help))
    (copyfiles (source (tackon #roms "PARA200J")) (dest #data) (help @copyfiles-help))
  ))
; Create only missing slots: Keep must never replace existing saves.
(if (exists (tackon #data "nvram.bin"))
  (if (<> (getsize (tackon #data "nvram.bin")) 32768)
    (abort "Invalid save size: nvram.bin. Your file has been preserved.")))
(if (exists (tackon #data "accounting.bin"))
  (if (<> (getsize (tackon #data "accounting.bin")) 940)
    (abort "Invalid save size: accounting.bin. Your file has been preserved.")))
(if (= (exists (tackon #data "nvram.bin")) 0)
  (copyfiles (source (tackon #source "EmptyNVRAM")) (dest #data) (newname "nvram.bin") (help @copyfiles-help)))
(if (= (exists (tackon #data "accounting.bin")) 0)
  (copyfiles (source (tackon #source "FreshAccounting")) (dest #data) (newname "accounting.bin") (help @copyfiles-help)))
(copyfiles (source (tackon #source "RAYPokeri")) (dest #data) (help @copyfiles-help))
(copyfiles (source (tackon #source "RAYPokeri.slave")) (dest #dest) (help @copyfiles-help))
(copyfiles (source (tackon #source "RAYPokeri.inf")) (dest #dest) (newname "RAYPokeri.info") (help @copyfiles-help))
(tooltype (dest (tackon #dest "RAYPokeri")) (setdefaulttool "WHDLoad")
  (settooltype "Slave" "RAYPokeri.slave") (settooltype "PreLoad" "")
  (setstack 10240) (noposition))
(copyfiles (source (tackon #source "ReadMe")) (dest #dest) (infos) (help @copyfiles-help))
(set @default-dest #dest)
(complete 100)
(exit)
